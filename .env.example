# Скопируйте в .env и поменяйте, что нужно. Без .env стенд стартует на значениях по умолчанию.

# Подпись входа — на любом общем стенде своя: openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-change-me-on-deploy
# Адрес фронта — из него собирается ссылка в письме подтверждения
FRONTEND_URL=http://localhost:3000
# true — cookie входа только по HTTPS (на стенде за TLS)
COOKIE_SECURE=false
# Имя cookie входа: cookie не изолируются по порту, свои имя защищает от чужих приложений на localhost
SESSION_COOKIE_NAME=calibr_session

# ФСП ID — OpenID Connect. Настоящий ФСП ID — смена этих значений, без правки кода.
# Публичный адрес realm (его видит браузер, он же iss в токенах); по умолчанию — localhost:KEYCLOAK_PORT
# FSP_ID_ISSUER=http://localhost:8080/realms/fsp-id
# Адрес, по которому до ФСП ID ходит бэкенд, если он другой; для настоящего ФСП ID — как FSP_ID_ISSUER
FSP_ID_SERVER_URL=http://keycloak:8080/realms/fsp-id
FSP_ID_CLIENT_ID=lct-platform
FSP_ID_CLIENT_SECRET=dev-only-fsp-id-client-secret
# Куда ФСП ID возвращает браузер; по умолчанию — FRONTEND_URL/api/auth/fsp/callback. Realm стенда
# пускает только localhost:3000 и localhost:8000 — другой порт фронта добавьте в redirect URI клиента
# FSP_ID_REDIRECT_URI=
# Заглушка реестра ФСП — JSON достижений по ФСП ID; по умолчанию backend/config/fsp_registry.json
# FSP_REGISTRY_PATH=

# Разбор потребности из текста: rules (по умолчанию) или llama — локальная модель llama.cpp,
# сервис поднимается своим profile: docker compose --profile llama up --build. Модель не
# ответила за таймаут — разбор отвечает правилами
# TEXT_UNDERSTANDING=rules
# TEXT_UNDERSTANDING_TIMEOUT_SECONDS=10
# Файл модели GGUF в ./models и ресурсы контейнера llama-server
# LLAMA_MODEL_FILE=model.gguf
# LLAMA_THREADS=8
# LLAMA_CTX_SIZE=8192
# LLAMA_MEM_LIMIT=16g

# Порты на хосте
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
KEYCLOAK_PORT=8080
